APP_NAME=Hubly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Same DB the Node backend uses (XAMPP MySQL). Schema is server/sql/schema.sql —
# this app never runs `artisan migrate` against it; see server-laravel/README.md.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mainframe_app
DB_USERNAME=root
DB_PASSWORD=

# No `sessions`/`jobs` tables in the shared schema — file-based session/queue
# keep this app from needing any Eloquent-managed tables of its own.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- Hubly (ported from server/.env.example) ----
# Generate a long random string (>= 32 chars) — same requirements as the Node
# backend. Must NOT match the Node API's secret unless you want tokens issued
# by one to be valid on the other.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated allowlist of browser origins permitted to call the API.
# Leave empty in dev (allows all + warns). e.g. CORS_ORIGINS=https://mainframe.company.local
CORS_ORIGINS=

# Trust the X-Forwarded-For header behind a reverse proxy, so rate limiting
# keys off the real client IP instead of the proxy's. Values: 'true' (trust
# all — the usual case for shared hosting with one front-end web server in
# front of PHP-FPM), 'false'/empty (trust none — correct for local dev / a
# direct connection), or a specific proxy IP/CIDR (comma-separated for more
# than one). Unlike the Node backend, this has no hop-count mode.
TRUST_PROXY=

# Base URL of the client app, used to build links in emails (password reset, etc).
APP_BASE_URL=http://localhost:5173

# Shared secret for the HTTP cron fallback (GET/POST /cron/sla-monitor) — only
# needed if your Hostinger plan can't run a CLI cron command (php artisan
# sla:monitor is the preferred path). Leave empty to disable the endpoint.
CRON_SECRET=

# Optional — outbound email. Leave both empty to disable (sends become logged
# no-ops, app still works). Resend takes priority when both are set.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hubly Ticketing <it@company.local>"

# Optional — UniFi local controller for the Network Monitoring dashboard.
# Leave UNIFI_HOST empty to render the page with mock data.
UNIFI_HOST=
UNIFI_USERNAME=
UNIFI_PASSWORD=
UNIFI_SITE=default
UNIFI_OS=
UNIFI_INSECURE_TLS=true
UNIFI_COOKIE=

# Optional — enables auto-extraction of network traffic charts from uploaded
# images (used by POST /api/network/extract-chart).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
