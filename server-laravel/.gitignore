# Ticket attachments (mirrors server/uploads/ being gitignored)
/uploads/tickets/*
!/uploads/tickets/.gitkeep

# Avatar uploads
/uploads/avatars/*
!/uploads/avatars/.gitkeep

# Message (mailbox) attachments
/uploads/messages/*
!/uploads/messages/.gitkeep

# KB article media uploads
/uploads/kb/*
!/uploads/kb/.gitkeep

# Spaces document + comment attachments
/uploads/spaces/*
!/uploads/spaces/.gitkeep
