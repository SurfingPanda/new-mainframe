# Backend origin used by `vite build` (production). The frontend on Hostinger
# (hubly.eljincorp.com) calls the API + loads uploads from this Railway-hosted
# origin. Same registrable domain as the frontend, so the auth cookie stays
# same-site (SameSite=Lax) and no cookie changes are needed.
# This is a public URL, not a secret.
VITE_API_URL=https://api.eljincorp.com
