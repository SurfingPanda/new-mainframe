# Backend origin used by `vite build` (production). The Laravel backend is
# path-mounted under this same Hostinger site at /backend (see
# server-laravel/DEPLOYMENT.md's topology note) — true same-origin with the
# frontend, not a separate domain. The client appends /api/... and
# /uploads/... itself (see src/lib/config.js), so this must NOT have a
# trailing /api — just the /backend prefix.
# This is a public URL, not a secret.
VITE_API_URL=https://hubly.eljincorp.com/backend
