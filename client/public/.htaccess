# Hubly frontend — static Vite build on Hostinger (Apache/LiteSpeed)
# The Laravel API lives at /backend under this same host+doc root (see
# backend/.htaccess + backend/index.php) — same-origin with the SPA.

# ----------------------------------------------------------------------
# Force HTTPS (cookies are Secure in production; the app must be on https)
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect any http:// request to https://
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ----------------------------------------------------------------------
  # SPA fallback: react-router handles routing client-side, so any path
  # that is NOT a real file or directory must serve index.html — EXCEPT
  # /backend/*, which is the Laravel API mounted in its own subfolder with
  # its own .htaccess/front controller. Without this exclusion this rule
  # fires first (there's no literal file at e.g. /backend/api/auth/login)
  # and every API request would get index.html instead of ever reaching
  # Laravel.
  # ----------------------------------------------------------------------
  RewriteBase /
  RewriteCond %{REQUEST_URI} !^/backend/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# Compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript \
    application/javascript application/json application/xml image/svg+xml \
    font/ttf font/otf font/woff font/woff2 application/font-woff
</IfModule>

# ----------------------------------------------------------------------
# Caching
#  - Vite emits content-hashed filenames under /assets/, so cache them hard.
#  - index.html must NOT be cached, or users keep the old build after a deploy.
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Hashed static assets — safe to cache for a year (immutable)
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|avif|ico)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Never cache the HTML entry point (or the build stamp used to verify deploys)
  <FilesMatch "(\.html|^version\.json)$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# Basic security headers for the static host.
# (Laravel's own SecurityHeaders middleware sets its response headers under
# /backend; these cover the frontend files. The API is same-origin now, so
# a plain 'self' CSP covers it too — no external backend host to list.)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Uncomment once verified against the app (uploads/avatars are same-origin
  # under /backend/uploads, so 'self' covers img-src/connect-src too):
  # Header always set Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
</IfModule>

# ----------------------------------------------------------------------
# Optional: block access to source maps in production (remove if you want them)
# ----------------------------------------------------------------------
<FilesMatch "\.map$">
  Require all denied
</FilesMatch>
