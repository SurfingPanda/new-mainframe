PORT=4000

# MySQL (XAMPP defaults)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mainframe_app

# Generate a long random string (>= 32 chars). The server refuses to start if
# this is unset OR left at this placeholder value (it's public, so a token signed
# with it could be forged), and warns if shorter than 32 chars.
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Set in production for security headers (HSTS) and to lock down CORS.
NODE_ENV=development
# Comma-separated allowlist of browser origins permitted to call the API.
# Leave empty in dev (allows all + warns). e.g. CORS_ORIGINS=https://mainframe.company.local
CORS_ORIGINS=

# Trust the X-Forwarded-For header so req.ip is the real client IP behind a
# reverse proxy (required for correct per-IP rate limiting). Leave empty for
# direct connections / local dev. Values: 'true', 'false', a hop count (e.g. 1),
# or an Express trust string (e.g. 'loopback'). Set to the number of proxies in
# front of the app, or 'true' if terminating behind exactly one trusted proxy.
TRUST_PROXY=

# Optional — outbound email (ticket/asset notifications + password-reset links).
# Leave both RESEND_API_KEY and SMTP_HOST empty to disable: sends become
# logged no-ops, app still works.
#
# Resend (recommended for production / hosted deploys): sends over HTTPS, so
# it works on hosts that block outbound SMTP ports (Railway, Render, etc — a
# blocked SMTP port surfaces as a silent "Connection timeout" from nodemailer,
# not an auth error). Takes priority over SMTP_* below when set.
#   1. Sign up at https://resend.com and verify your sending domain (DNS
#      records) — or use their default onboarding@resend.dev sender to test.
#   2. Create an API key: https://resend.com/api-keys
#   3. Set RESEND_API_KEY below and MAIL_FROM to an address on your verified
#      domain (e.g. "Hubly Ticketing <no-reply@yourdomain.com>").
RESEND_API_KEY=
#
# SMTP fallback (used only when RESEND_API_KEY is empty) — fine for local dev,
# but many hosts block outbound SMTP in production. For local testing use
# Mailpit/MailHog (SMTP_HOST=localhost SMTP_PORT=1025).
#
# Gmail / Google Workspace: use an APP PASSWORD, not your account password.
#   1. Turn on 2-Step Verification: https://myaccount.google.com/signinoptions/two-step-verification
#   2. Create an app password ("Mail" / custom name): https://myaccount.google.com/apppasswords
#   3. Paste the 16-char value into SMTP_PASS (spaces optional — Gmail ignores them).
# Gmail requires the From address to match the authenticated account (or a
# verified "Send mail as" alias), so keep MAIL_FROM on the same address.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587            # STARTTLS; or 465 with SMTP_SECURE=true
#   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   MAIL_FROM="Hubly Ticketing <you@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hubly Ticketing <it@company.local>"
# Base URL of the client app, used to build links in emails (e.g. reset password).
APP_BASE_URL=http://localhost:5173

# Optional — enables auto-extraction of network traffic charts from uploaded images
# (used by POST /api/network/extract-chart). Get a key at https://console.anthropic.com.
ANTHROPIC_API_KEY=
# Override the default model if you want
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional — UniFi local controller for the Network Monitoring dashboard
# (used by GET /api/network/dashboard). Leave UNIFI_HOST empty to render the
# page with mock data.
#
#   UNIFI_HOST              Controller URL — e.g. https://unifi.local:8443
#                           (classic) or https://192.168.1.1 (UniFi OS / UDM)
#   UNIFI_USERNAME          Local admin username
#   UNIFI_PASSWORD          Local admin password
#   UNIFI_SITE              Site name (default: 'default')
#   UNIFI_OS                'true' for UniFi OS / UDM / Cloud Key Gen2+ —
#                           prefixes API calls with /proxy/network. Leave
#                           empty for a classic controller (:8443) or the
#                           modern self-hosted UniFi Network Server (:8080).
#                           The login endpoint is auto-detected.
#   UNIFI_INSECURE_TLS      'true' to accept the controller's self-signed cert
#   UNIFI_COOKIE            Optional. If set, the backend skips login and
#                           uses this raw Cookie header value for all API
#                           calls. Useful when the admin requires 2FA / SSO
#                           and no local admin / API key is available — copy
#                           the cookie from your logged-in browser session
#                           (DevTools → Application → Cookies). Re-paste
#                           when it expires. When set, UNIFI_USERNAME and
#                           UNIFI_PASSWORD are ignored.
UNIFI_HOST=
UNIFI_USERNAME=
UNIFI_PASSWORD=
UNIFI_SITE=default
UNIFI_OS=
UNIFI_INSECURE_TLS=true
UNIFI_COOKIE=
